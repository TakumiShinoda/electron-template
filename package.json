{
  "name": "electron-template",
  "version": "1.0.0",
  "nodeVersion": "20.10.0",
  "description": "",
  "main": "./src/app/main.js",
  "scripts": {
    "start": "gulp start",
    "clean-start": "npm run reset-dev && npm start",
    "clean-env": "rmdir /s /q node_modules & del package-lock.json & del yarn.lock",
    "clean-dist": "rmdir /s /q dist",
    "clean-build": "rmdir /s /q publish",
    "reset-dev": "npm run reset-env && npm run clean-dist",
    "reset-env": "npm run clean-env && yarn",
    "reset-dist": "npm run clean-dist && npm run dist",
    "reset-build": "npm run reset-env && npm run reset-dist && npm run clean-build",
    "dist": "gulp dist",
    "build-win": "npm run reset-build && electron-builder --win"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jquery": "3.3.14",
    "@types/node": "20.10.0",
    "css-loader": "7.1.2",
    "electron": "40.0.0",
    "electron-builder": "24.13.3",
    "electron-connect": "0.6.3",
    "electron-reload": "2.0.0-alpha.1",
    "gulp": "5.0.1",
    "gulp-plumber": "1.2.1",
    "gulp-pug": "5.0.0",
    "lodash": "4.17.21",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.4",
    "typescript": "5.9.3",
    "webpack": "5.104.1"
  },
  "dependencies": {
    "graceful-fs": "4.2.10",
    "jquery": "3.3.1"
  },
  "build": {
    "directories": {
      "output": "publish"
    },
    "productName": "electron-template",
    "appId": "app.electron-template",
    "files": [
      "./src/app/**",
      "./node_modules/**",
      "./dist/**",
      "./dev/**"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
